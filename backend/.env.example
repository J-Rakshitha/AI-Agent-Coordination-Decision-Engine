# ===== AI Agent Coordination & Decision Engine - Backend Config =====

# App
APP_NAME=AI Agent Coordination & Decision Engine
ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for dev, switch to Postgres URL in production)
DATABASE_URL=sqlite+aiosqlite:///./coordination_engine.db

# LLM Provider (Hybrid: LLM + Rule-based fallback)
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_ENABLED=True
LLM_TIMEOUT_SECONDS=6

# CORS - frontend origins allowed to call this backend
FRONTEND_ORIGIN=http://localhost:5173

# Synthetic Data Generator (for safe, error-free live demos)
SYNTHETIC_DATA_ENABLED=True

# Real GitHub Integration (Phase A)
# Create a token at: https://github.com/settings/tokens (classic, scope: repo)
# NEVER commit your real token — this file is just a template.
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO_OWNER=J-Rakshitha
GITHUB_REPO_NAME=dev-collab-test-repo
