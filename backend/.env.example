# ===== AI Agent Coordination & Decision Engine - Backend Config =====

# App
APP_NAME=AI Agent Coordination & Decision Engine
ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for dev, switch to Postgres URL in production)
DATABASE_URL=sqlite+aiosqlite:///./coordination_engine.db

# LLM Provider (Hybrid: LLM + Rule-based fallback)
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_ENABLED=True
LLM_TIMEOUT_SECONDS=6
LLM_MODEL=gemini-flash-latest

# CORS - frontend origins allowed to call this backend
FRONTEND_ORIGIN=http://localhost:5173

# Synthetic Data Generator (for safe, error-free live demos)
SYNTHETIC_DATA_ENABLED=True

# Real GitHub Integration (Phase A)
# Create a token at: https://github.com/settings/tokens (classic, scope: repo)
# NEVER commit your real token — this file is just a template.
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO_OWNER=J-Rakshitha
GITHUB_REPO_NAME=dev-collab-test-repo
# GitHub webhook — secret from repo Settings → Webhooks (Content type: application/json)
GITHUB_WEBHOOK_SECRET=
# Public backend URL (for webhook setup docs; use ngrok/Render URL when exposing webhooks locally)
PUBLIC_BACKEND_URL=http://localhost:8000

# Phase B — Real Server Monitoring (background probes)
MONITORING_ENABLED=True
MONITOR_INTERVAL_SECONDS=30
MONITORING_RESPONSE_TIME_MS_THRESHOLD=1500
MONITORING_ERROR_RATE_PCT_THRESHOLD=10
MONITORING_DB_POOL_USAGE_PCT_THRESHOLD=85
MONITOR_BACKEND_NAME=coordination-engine-backend
MONITOR_BACKEND_URL=http://127.0.0.1:8000/api/system/health
MONITOR_EXTERNAL_NAME=github-external-api
MONITOR_EXTERNAL_URL=https://api.github.com

# Phase C — Multi-user Login (JWT)
AUTH_SECRET_KEY=change-me-in-production-use-a-long-random-string

# Notification Agent — Gmail SMTP (real email when configured; simulated otherwise)
# Gmail: myaccount.google.com/security → 2-Step ON → App passwords → 16-char password
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_FROM_EMAIL=your-email@gmail.com
NOTIFICATION_ONCALL_EMAIL=your-email@gmail.com
NOTIFICATION_TEAM_EMAILS=your-email@gmail.com
NOTIFICATION_SMTP_HOST=smtp.gmail.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=your-email@gmail.com
NOTIFICATION_SMTP_PASSWORD=your-gmail-app-password-here

# Slack / Discord / Microsoft Teams — optional real-time alerts (incoming webhook URLs)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
